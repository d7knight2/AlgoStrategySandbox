{
  "name": "AlgoStrategySandbox",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "true",
  "terminals": [
    {
      "name": "next-dev",
      "command": "npm run dev",
      "description": "Next.js frontend on port 3000"
    },
    {
      "name": "trading-api",
      "command": "cd python && TRADING_MODE=paper ALPACA_API_KEY=\"${ALPACA_API_KEY:-test-key-not-real}\" ALPACA_SECRET_KEY=\"${ALPACA_SECRET_KEY:-test-secret-not-real}\" PYTHONPATH=\"$PWD\" .venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8000",
      "description": "FastAPI paper trading API on port 8000"
    }
  ],
  "ports": [
    { "name": "next-dev", "port": 3000 },
    { "name": "trading-api", "port": 8000 }
  ]
}
