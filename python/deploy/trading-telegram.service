[Unit]
Description=Trading Core Telegram command poller (chat-id allowlist)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python
Environment=PYTHONPATH=/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python
Environment=TRADING_MODE=paper
ExecStart=/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python/.venv/bin/python -m src.notifications.bot
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python/data/reports/telegram.log
StandardError=append:/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python/data/reports/telegram.log

[Install]
WantedBy=default.target
