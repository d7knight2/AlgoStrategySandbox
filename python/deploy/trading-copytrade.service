[Unit]
Description=Trading Core daily public-disclosure digest + paper copy
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python
Environment=PYTHONPATH=/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python
Environment=TRADING_MODE=paper
Environment=COPYTRADE_EXECUTE_PAPER=true
ExecStart=/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python/.venv/bin/python -m src.copytrade.daily --execute
StandardOutput=append:/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python/data/reports/copytrade.log
StandardError=append:/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python/data/reports/copytrade.log
