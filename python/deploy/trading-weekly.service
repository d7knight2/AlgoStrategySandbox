[Unit]
Description=Trading Core weekly paper-funds recap (+ optional AI)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python
Environment=PYTHONPATH=/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python
Environment=TRADING_MODE=paper
Environment=WEEKLY_AI=1
Environment=WEEKLY_AI_IMAGE=1
ExecStart=/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python/.venv/bin/python -m src.reporting.weekly_job
StandardOutput=append:/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python/data/reports/weekly.log
StandardError=append:/home/d7knight/repos/d7knight2/AlgoStrategySandbox/python/data/reports/weekly.log
