# QuantConnect API Configuration
NEXT_PUBLIC_QUANTCONNECT_USER_ID=your_user_id_here
NEXT_PUBLIC_QUANTCONNECT_API_TOKEN=your_api_token_here
QUANTCONNECT_API_BASE_URL=https://www.quantconnect.com/api/v2

# Pi MCP (Cursor) - set in Cursor MCP env, not committed
# PI_MCP_API_KEY=your_provider_api_key_here

# Alpaca MCP (Cursor) - set in Cursor MCP env, not committed
# ALPACA_API_KEY=your_alpaca_paper_key_id
# ALPACA_SECRET_KEY=your_alpaca_paper_secret_key

# Alpaca paper trading (Lumibot Python scripts)
# APCA_API_KEY_ID=your_key
# APCA_API_SECRET_KEY=your_secret
# APCA_API_BASE_URL=https://paper-api.alpaca.markets
